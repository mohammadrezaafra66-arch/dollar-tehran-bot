{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job",
  "type": "object",
  "required": [
    "job_type",
    "plugin_name",
    "status",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "job_type": {
      "type": "string"
    },
    "plugin_name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "speed_profile": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "retry_count": {
      "type": "integer"
    },
    "max_retry": {
      "type": "integer"
    }
  }
}
