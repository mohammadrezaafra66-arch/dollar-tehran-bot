{
  "app": {
    "timezone": "Asia/Tehran",
    "timeout_seconds": 20,
    "sleep_between_sources_seconds": 1,
    "sqlite_path": "data/market_data.db",
    "output_dir": "output",
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
  },
  "schedule": {"interval_minutes": 3},
  "sync": {"enabled": false, "api_url": "${AFRA_API_URL}", "api_token": "${AFRA_API_TOKEN}", "timeout_seconds": 30},
  "indicators": [
    {
      "code": "usd_tehran",
      "name": "دلار تهران",
      "unit": "toman",
      "sources": [
        {
          "code": "tgju_usd_tehran_current",
          "name": "TGJU - دلار تهران",
          "url": "https://www.tgju.org/profile/price_dollar_rl",
          "enabled": true,
          "price_kind": "current",
          "unit": "rial",
          "extractors": [
            {"kind": "css", "selector": "#main > div.stocks-profile > div.fs-row.bootstrap-fix.widgets.full-w-set.profile-social-share-box > div.row.tgju-widgets-row > div.tgju-widgets-block.col-md-12.col-lg-4.tgju-widgets-block-bottom-unset.overview-first-block > div > div:nth-child(2) > div > div.tables-default.normal > table > tbody > tr:nth-child(1) > td.text-left"},
            {"kind": "css", "selector": "td.text-left"},
            {"kind": "regex", "pattern": "نرخ فعلی[:：\\s]*([0-9۰-۹٠-٩]{1,3}(?:[,،][0-9۰-۹٠-٩]{3})+)"},
            {"kind": "regex", "pattern": "<td[^>]*class=\\\"text-left\\\"[^>]*>\\s*([0-9,۰-۹٠-٩]+)\\s*</td>"}
          ]
        },
        {
          "code": "signal_usd_tehran_current",
          "name": "signal - دلار تهران",
          "url": "https://isignal.ir/gold-currency/usdollar/",
          "enabled": true,
          "price_kind": "current",
          "unit": "rial",
          "extractors": [
            {"kind": "row_contains", "contains": ["دلار", "ریال"], "index": 0},
            {"kind": "regex", "pattern": "<span class=\\\"text-surface-on-surface text-app-title-md[^\\\"]*direction-ltr\\\">([0-9,]+)</span>"}
          ]
        },
        {
          "code": "alanchand_usd_tehran_buy",
          "name": "alanchand - دلار تهران خرید",
          "url": "https://alanchand.com/en/currencies-price/usd",
          "enabled": true,
          "price_kind": "buy",
          "unit": "rial",
          "extractors": [
            {"kind": "css", "selector": "body > main > section.container.mostPopularRate > div > div > div:nth-child(2) > div > div > div > div > span"},
            {"kind": "row_contains", "contains": ["Buy rate for USD to IRR"], "index": 0}
          ]
        },
        {
          "code": "alanchand_usd_tehran_sell",
          "name": "alanchand - دلار تهران فروش",
          "url": "https://alanchand.com/en/currencies-price/usd",
          "enabled": true,
          "price_kind": "sell",
          "unit": "rial",
          "extractors": [
            {"kind": "css", "selector": "body > main > section.container.mostPopularRate > div > div > div:nth-child(1) > div > div > div > div > span.fw-bold.text-success.fs-5"},
            {"kind": "row_contains", "contains": ["Sell rate for USD to IRR"], "index": 0}
          ]
        },
        {
          "code": "bonbast_usd_tehran_sell",
          "name": "Bonbast - دلار تهران فروش",
          "url": "https://www.bonbast.com/",
          "enabled": true,
          "price_kind": "sell",
          "unit": "toman",
          "extractors": [
            {"kind": "css", "selector": "#usd1"},
            {"kind": "regex", "pattern": "<td[^>]*id=\\\"usd1\\\"[^>]*>\\s*([0-9,۰-۹٠-٩]+)\\s*</td>"}
          ]
        },
        {
          "code": "bonbast_usd_tehran_buy",
          "name": "Bonbast - دلار تهران خرید",
          "url": "https://www.bonbast.com/",
          "enabled": true,
          "price_kind": "buy",
          "unit": "toman",
          "extractors": [
            {"kind": "css", "selector": "#usd2"},
            {"kind": "regex", "pattern": "<td[^>]*id=\\\"usd2\\\"[^>]*>\\s*([0-9,۰-۹٠-٩]+)\\s*</td>"}
          ]
        },
        {
          "code": "tabdeal_usd_tehran_current",
          "name": "Tabdeal - دلار تهران",
          "url": "https://tabdeal.org/live/currency",
          "enabled": true,
          "price_kind": "current",
          "unit": "toman",
          "extractors": [
            {"kind": "row_contains", "contains": ["دلار", "تومان"], "index": 0},
            {"kind": "regex", "pattern": "دلار[\\s\\S]{0,250}?تومان[\\s\\S]{0,80}?([0-9۰-۹٠-٩]{1,3}(?:[,،][0-9۰-۹٠-٩]{3})+)"}
          ]
        }
      ]
    },
    {
      "code": "aed_tehran",
      "name": "درهم امارات",
      "unit": "toman",
      "sources": [
        {
          "code": "tgju_aed_current",
          "name": "TGJU - درهم امارات",
          "url": "https://www.tgju.org/profile/price_aed",
          "enabled": true,
          "price_kind": "current",
          "unit": "rial",
          "extractors": [
            {"kind": "css", "selector": "#main > div.stocks-profile > div.fs-row.bootstrap-fix.widgets.full-w-set.profile-social-share-box > div.row.tgju-widgets-row > div.tgju-widgets-block.col-md-12.col-lg-4.tgju-widgets-block-bottom-unset.overview-first-block > div > div:nth-child(2) > div > div.tables-default.normal > table > tbody > tr:nth-child(1) > td.text-left"},
            {"kind": "css", "selector": "td.text-left"},
            {"kind": "regex", "pattern": "نرخ فعلی[:：\\s]*([0-9۰-۹٠-٩]{1,3}(?:[,،][0-9۰-۹٠-٩]{3})+)"},
            {"kind": "regex", "pattern": "<td[^>]*class=\\\"text-left\\\"[^>]*>\\s*([0-9,۰-۹٠-٩]+)\\s*</td>"}
          ]
        }
      ]
    },
    {
      "code": "eur_tehran",
      "name": "یورو",
      "unit": "toman",
      "sources": [
        {
          "code": "tgju_eur_current",
          "name": "TGJU - یورو",
          "url": "https://www.tgju.org/profile/price_eur",
          "enabled": true,
          "price_kind": "current",
          "unit": "rial",
          "extractors": [
            {"kind": "css", "selector": "#main > div.stocks-profile > div.fs-row.bootstrap-fix.widgets.full-w-set.profile-social-share-box > div.row.tgju-widgets-row > div.tgju-widgets-block.col-md-12.col-lg-4.tgju-widgets-block-bottom-unset.overview-first-block > div > div:nth-child(2) > div > div.tables-default.normal > table > tbody > tr:nth-child(1) > td.text-left"},
            {"kind": "css", "selector": "td.text-left"},
            {"kind": "regex", "pattern": "نرخ فعلی[:：\\s]*([0-9۰-۹٠-٩]{1,3}(?:[,،][0-9۰-۹٠-٩]{3})+)"},
            {"kind": "regex", "pattern": "<td[^>]*class=\\\"text-left\\\"[^>]*>\\s*([0-9,۰-۹٠-٩]+)\\s*</td>"}
          ]
        }
      ]
    }
  ]
}
