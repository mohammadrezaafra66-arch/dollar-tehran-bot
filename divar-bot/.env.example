# افراکالا API
AFRAKALA_API_URL=http://192.168.170.8:8000
AFRAKALA_API_KEY=

# DeepSeek (Ollama محلی)
DEEPSEEK_BASE_URL=http://localhost:11434
DEEPSEEK_MODEL=deepseek-r1

# دیوار
DIVAR_DAILY_MESSAGE_LIMIT=30
DIVAR_MIN_DELAY_SECONDS=20
DIVAR_MAX_DELAY_SECONDS=60
DIVAR_PROFILE_DIR=runtime/profiles/divar
DIVAR_MAX_ADS_PER_RUN=200

# دیتابیس
DIVAR_DB_PATH=data/divar_leads.db

# ارسال پیام — پیش‌فرض false برای امنیت
ENABLE_MESSAGING=false

# پروکسی (اختیاری — خالی = بدون پروکسی)
HTTP_PROXY=
